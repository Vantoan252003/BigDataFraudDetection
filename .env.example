# ══════════════════════════════════════════════════════════════════
# FraudDetectionSystem — Environment Variables Template
# Copy this file to .env and fill in your values:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ── Kafka ─────────────────────────────────────────────────────────
BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=transactions-data

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=fraud_db
DB_URL=jdbc:postgresql://postgres:5432/fraud_db
DATABASE_URL=postgresql://fraud_user:CHANGE_ME_strong_password_here@postgres:5432/fraud_db

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=fraud_redis
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── FastAPI Security ─────────────────────────────────────────────
FRAUD_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64

# ── MLflow ────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Producer ──────────────────────────────────────────────────────
PAYSIM_PATH=data/paysim.csv
PRODUCER_DELAY=0.01
